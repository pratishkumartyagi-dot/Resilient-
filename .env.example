# Copy this file to .env.local and fill in the values you need.
# All variables are OPTIONAL — the app runs without any of them.
# Step 1 ("Search Databases") works with the public scholarly APIs out of the box;
# the keys below only raise rate limits or enable optional sources.

# Optional: Tavily API key for the open-web fallback in Step 1 and for the
# Cochrane Library source (which has no public API).
# Get a key at https://tavily.com
TAVILY_API_KEY=

# Optional: OpenAlex API key. Without it OpenAlex counts against the shared
# daily budget of your network's IP address and may answer HTTP 429.
# Get a key at https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_API_KEY=

# Optional: Semantic Scholar API key. Without it the shared-IP quota applies
# and the Graph API may answer HTTP 429.
# Get a key at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Optional: NCBI API key for PubMed E-utilities. Raises the requests/second
# limit from 3 to 10 and makes large searches much faster.
# Get a key at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Optional: contact e-mail used in the polite-pool parameters of OpenAlex
# and NCBI, and in the outgoing User-Agent header.
# RESEARCH_CONTACT_EMAIL=

# Optional: port for the dev/production server (default: 3000)
# PORT=3000

# Optional: path to external paper-search CLI binaries (advanced).
# Not required — Step 1 search works via direct scholarly APIs.
# PAPER_SEARCH_MCP_BIN=
# PAPER_SEARCH_BIN=

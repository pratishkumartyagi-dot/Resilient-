{
  "name": "resilient-research-app",
  "version": "0.8.6",
  "private": true,
  "description": "AI-powered research intelligence platform for systematic reviews, evidence synthesis, and academic writing.",
  "author": "Resilient Research App",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "electron": "next build --webpack && electron .",
    "electron:run": "electron .",
    "dist": "next build --webpack && electron-builder --publish never",
    "dist:win": "next build --webpack && electron-builder --win --publish never",
    "dist:mac": "next build --webpack && electron-builder --mac --publish never",
    "dist:linux": "next build --webpack && electron-builder --linux --publish never",
    "dist:dir": "next build --webpack && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "cheerio": "^1.2.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.12.0",
    "markdown-docx": "^1.7.0",
    "marked": "^15.0.7",
    "next": "^16.1.3",
    "pdfjs-dist": "^6.0.227",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.8.1",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/cheerio": "^1.0.0",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.resilient.researchapp",
    "productName": "Resilient Research App",
    "copyright": "Copyright © 2024 Resilient Research Team",
    "asar": true,
    "directories": {
      "output": "dist-electron",
      "buildResources": "electron/build"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!**/.next/**",
      "!**/.next/cache/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "."
      },
      {
        "from": ".next/static",
        "to": ".next/static"
      },
      {
        "from": "public",
        "to": "public"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Resilient Research App",
      "uninstallDisplayName": "Resilient Research App",
      "license": "electron/build/license.txt",
      "installerIcon": "electron/build/icon.ico",
      "uninstallerIcon": "electron/build/icon.ico",
      "installerHeaderIcon": "electron/build/icon.ico",
      "include": "electron/build/installer.nsh",
      "artifactName": "Resilient-Research-App-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "electron/build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "title": "Resilient Research App",
      "icon": "electron/build/icon.icns",
      "artifactName": "Resilient-Research-App-${version}.dmg"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/build/icon.png",
      "category": "Office",
      "artifactName": "Resilient-Research-App-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "pratishkumartyagi-dot",
      "repo": "Resilient-"
    }
  }
}
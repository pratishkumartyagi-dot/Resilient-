{
  "name": "resilient-research-app",
  "version": "0.2.4",
  "private": true,
  "description": "AI-powered research intelligence platform for systematic reviews, evidence synthesis, and academic writing.",
  "author": "Resilient Research App",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "electron": "next build && electron .",
    "electron:run": "electron .",
    "dist": "next build && electron-builder --publish never",
    "dist:win": "next build && electron-builder --win --publish never",
    "dist:mac": "next build && electron-builder --mac --publish never",
    "dist:linux": "next build && electron-builder --linux --publish never",
    "dist:dir": "next build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "cheerio": "^1.2.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.12.0",
    "markdown-docx": "^1.7.0",
    "marked": "^15.0.7",
    "next": "^16.1.3",
    "pdfjs-dist": "^6.0.227",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.8.1",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/cheerio": "^1.0.0",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.resilient.researchapp",
    "productName": "Resilient Research App",
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "**/*",
      "!**/.next/cache/**",
      "!dist-electron/**",
      "!.git/**",
      "!.kilocode/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Science"
    }
  }
}
